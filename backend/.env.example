# ─────────────────────────────────────────────────────────────────────────────
#  Tera5G Backend — Environment Variables
#  Copy this file: cp .env.example .env  then fill in every value.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# Public URL of this backend (no trailing slash).
# Yo! Uganda posts payment webhooks to: PUBLIC_URL/api/pay/webhook
PUBLIC_URL=https://api.tera5g.app

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# ── Config Encryption ─────────────────────────────────────────────────────────
# 64-character hex key (32 bytes). Shared with the Android app.
# Generate: openssl rand -hex 32
# MUST match CONFIG_AES_KEY in android/local.properties — identical value.
CONFIG_AES_KEY=

# ── Admin API ─────────────────────────────────────────────────────────────────
# Strong random string. Pass as X-Admin-Key header to /api/admin/* endpoints.
# Generate: openssl rand -base64 32
ADMIN_KEY=

# ── Yo! Uganda Mobile Money ───────────────────────────────────────────────────
# Register at https://yo.co.ug/ — credentials provided after merchant approval.
# Your server's STATIC PUBLIC IP must be whitelisted by Yo! Uganda support
# before any API call will succeed.
YO_API_USERNAME=
YO_API_PASSWORD=

# Optional: some Yo! account tiers use a separate Authorization token.
# YO_AUTHORIZATION=

# Optional: Fixie static-IP proxy (https://usefixie.com/).
# Use this if your hosting (e.g. Railway, Render) doesn't give a static IP.
# Fixie routes your outbound calls through fixed IPs you can whitelist with Yo!
# FIXIE_URL=http://fixie:FIXIE_PASSWORD@velodrome.usefixie.com:80

# Custom Yo! API endpoint — leave blank to use the default live URL.
# YO_API_URL=https://paymentsapi1.yo.co.ug/ybs/task.php

# ── CORS (optional — only for browser-based admin frontends) ──────────────────
# The Android app sends no Origin header, so this only matters for web clients.
# CORS_ORIGINS=https://admin.tera5g.app
