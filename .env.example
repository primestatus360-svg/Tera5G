# ── Railway environment variables ────────────────────────────────────────────
# Set these in your Railway service's Variables tab.
# Railway injects PORT automatically — do not set it manually.

# Required
NODE_ENV=production
ADMIN_KEY=change-me-before-deploying

# Required for payment webhooks (Yo! Uganda)
# Must be your full Railway public URL, e.g. https://tera5g.up.railway.app
PUBLIC_URL=https://your-app.up.railway.app

# Optional — Yo! Uganda payment API credentials
YO_API_URL=https://paymentsapi1.yo.co.ug/ybs/task.php
YO_API_USERNAME=
YO_API_PASSWORD=

# Optional — HTTP proxy server for device bypass demo
# Railway does not expose this port publicly by default.
# Omit to disable the proxy (recommended for standard Railway deploys).
# PROXY_PORT=8080
